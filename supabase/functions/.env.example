# Secrets des fonctions Edge (côté serveur uniquement).
# Copiez en « supabase/functions/.env », puis : supabase secrets set --env-file supabase/functions/.env
# SUPABASE_URL et SUPABASE_SERVICE_ROLE_KEY sont fournis automatiquement par Supabase.

# Mode test Stripe pendant le développement (sk_test_…). Les clés sk_live_ sont refusées
# tant que STRIPE_ALLOW_LIVE n'est pas à true.
STRIPE_SECRET_KEY=sk_test_remplacez_moi
STRIPE_WEBHOOK_SECRET=whsec_remplacez_moi
# STRIPE_ALLOW_LIVE=false

# Générés par « node scripts/stripe-setup.mjs »
STRIPE_PRICE_PRO=price_remplacez_moi
STRIPE_PRICE_STUDIO=price_remplacez_moi
STRIPE_PORTAL_CONFIGURATION=

# URL publique de l'application (redirections Checkout et portail)
SITE_URL=http://localhost:5173
